      },
      {
        "from": "l1",
        "to": "counter",
        "style": "dashed"
      },
      {
        "from": "l3",
        "to": "fridge",
        "style": "dashed"
      },
      {
        "from": "ram",
        "to": "pantry",
        "style": "dashed"
      },
      {
        "from": "ssd",
